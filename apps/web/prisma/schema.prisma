// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id                String   @id @default(cuid())
  domains           String[]
  upstreamContainer String?  @map("upstream_container")
  upstreamPort      Int?     @map("upstream_port")
  dbName            String?  @map("db_name")
  dbUser            String?  @map("db_user")
  tlsMode           String   @default("acme") @map("tls_mode")
  serviceType       String   @default("proxy") @map("service_type")
  staticRoot        String?  @map("static_root")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("services")
}
