# --- Database ---
DB_NAME=portcullis
DB_USER=postgres
DB_PASSWORD=change_me
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public

# --- Gateway ---
# The domain where the manager UI is reachable
PORTCULLIS_DOMAIN=staging.yourdomain.com
# TLS Mode: internal | acme | dns01
#   "internal" = Caddy's local CA, self-signed certs (dev/staging without public ports)
#   "acme"     = Let's Encrypt via HTTP-01 challenge (requires port 80 reachable from internet)
#   "dns01"    = Let's Encrypt via DNS-01 challenge (for staging/internal networks, wildcard certs)
#                 Requires CADDY_DNS_PROVIDER and CADDY_DNS_CONFIG set below.
CADDY_TLS_MODE=internal
# URL of the Caddy Admin API (Docker networking handles this internally)
CADDY_ADMIN_API=http://localhost:2019

# --- DNS-01 Challenge (only used when CADDY_TLS_MODE is a dns provider snippet) ---
# CADDY_TLS_MODE selects the TLS snippet: internal | acme | namecheap_tls | cloudflare_tls | route53_tls
# CADDY_DNS_PROVIDER controls the Docker build (which caddy-dns plugin to compile).
# Each provider has its own {env.XXX} placeholders in the Caddyfile snippet.
#
# NameCheap (uncomment all 4 lines):
# CADDY_TLS_MODE=namecheap_tls
# CADDY_DNS_PROVIDER=namecheap
# NAMECHEAP_API_KEY=your_api_key
# NAMECHEAP_API_USER=your_username
#
# Cloudflare (uncomment all 3 lines):
# CADDY_TLS_MODE=cloudflare_tls
# CADDY_DNS_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=your_api_token
#
# Route53 (uses IAM role — uncomment 2 lines):
# CADDY_TLS_MODE=route53_tls
# CADDY_DNS_PROVIDER=route53

# --- Automatic Backups (portcullis_backup sidecar) ---
# Enable with: docker compose --profile backup up -d
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# --- Security ---
# Passcode for dashboard access (used for both login and API authentication)
PORTCULLIS_PASSCODE=change_me
# Session encryption secret — generate with: openssl rand -base64 32
PORTCULLIS_SESSION_SECRET=generate_with_openssl_rand_base64_32
