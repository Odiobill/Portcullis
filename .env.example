# --- Database ---
DB_NAME=portcullis
DB_USER=postgres
DB_PASSWORD=change_me

# Used by Prisma on the host. Docker Compose injects the container URL for nextjs_app.
# Replace the password with the same value as DB_PASSWORD when running host-side Prisma commands.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/portcullis?schema=public

# --- Gateway ---
# Public domain where the Portcullis dashboard is reachable.
PORTCULLIS_DOMAIN=staging.yourdomain.com

# TLS mode snippet used by the dashboard site and default service selection.
# Allowed: internal | acme | namecheap_tls | cloudflare_tls | route53_tls
# Heimdall/staging behind DNS-01 should use namecheap_tls.
CADDY_TLS_MODE=internal

# Caddy DNS provider plugin to compile into the Caddy and Next.js images.
# Empty for internal/acme. Allowed provider values used here: namecheap | cloudflare | route53
CADDY_DNS_PROVIDER=

# --- DNS-01 Challenge Credentials ---
# Namecheap, required when CADDY_TLS_MODE=namecheap_tls and CADDY_DNS_PROVIDER=namecheap.
# NAMECHEAP_API_KEY=your_api_key
# NAMECHEAP_API_USER=your_username

# Cloudflare, required when CADDY_TLS_MODE=cloudflare_tls and CADDY_DNS_PROVIDER=cloudflare.
# CLOUDFLARE_API_TOKEN=your_api_token

# Route53, required when CADDY_TLS_MODE=route53_tls and CADDY_DNS_PROVIDER=route53.
# Uses IAM/environment credentials provided to the container/host.

# --- Automatic Backups (portcullis_backup sidecar) ---
# Enable the sidecar with: docker compose --profile backup up -d
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# --- Security ---
# Passcode for dashboard login and the on-demand dump API bearer token.
PORTCULLIS_PASSCODE=change_me

# Reserved for future signed/encrypted session support. Current auth uses an httpOnly session cookie.
PORTCULLIS_SESSION_SECRET=generate_with_openssl_rand_base64_32
