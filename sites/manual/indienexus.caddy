# Operator-managed IndieNexus staging routes.
# Portcullis must not edit this file.

indienexus.{$PORTCULLIS_DOMAIN:staging.localhost} {
  import {$CADDY_TLS_MODE:acme}
  reverse_proxy indienexus_store:3000
}

api.indienexus.{$PORTCULLIS_DOMAIN:staging.localhost} {
  import {$CADDY_TLS_MODE:acme}
  reverse_proxy indienexus_api:3002
}
